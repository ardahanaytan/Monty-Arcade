---
/** <head> içeriği: meta, SEO (canonical, hreflang, OG), font preload ve global stiller. */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import archivoNormal from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import archivoItalic from '@fontsource-variable/archivo/files/archivo-latin-wdth-italic.woff2?url';
import archivoTrNormal from '../assets/fonts/archivo-tr-normal.woff2?url';
import archivoTrItalic from '../assets/fonts/archivo-tr-italic.woff2?url';

import { site } from '../config/site';
import { languages, useTranslations, type Lang } from '../i18n/ui';

export interface HeadProps {
  lang: Lang;
  /** Sayfa başlığı; boşsa ana sayfa biçimi kullanılır. */
  title?: string;
  description?: string;
  /** hreflang için her dildeki karşılık. */
  langPaths: Record<Lang, string>;
  /** Bu sayfanın gerçekten var olduğu diller (hreflang). Varsayılan: hepsi. */
  alternateLangs?: readonly Lang[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  langPaths,
  alternateLangs = languages,
  ogImage,
  ogType = 'website',
  noindex = false,
} = Astro.props;
const t = useTranslations(lang);

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${t('meta.tagline')}`;
const desc = description ?? t('meta.tagline');
const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base).href;
const ogImageUrl = new URL(ogImage ?? '/og-default.png', base).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
{
  noindex ? (
    <meta name="robots" content="noindex" />
  ) : (
    <>
      <link rel="canonical" href={canonical} />
      {alternateLangs.map((l: Lang) => (
        <link rel="alternate" hreflang={l} href={new URL(langPaths[l], base).href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={new URL('/', base).href} />
    </>
  )
}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#0d1328" />
<meta name="generator" content={Astro.generator} />

<link rel="preload" href={archivoNormal} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={archivoItalic} as="font" type="font/woff2" crossorigin />
{
  /* Türkçe harfler (Ğ ğ İ ı Ş ş) için küçük ek font (styles/fonts.css). */
  lang === 'tr' && (
    <>
      <link rel="preload" href={archivoTrNormal} as="font" type="font/woff2" crossorigin />
      <link rel="preload" href={archivoTrItalic} as="font" type="font/woff2" crossorigin />
    </>
  )
}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title ?? site.name} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
<meta name="twitter:card" content="summary_large_image" />
