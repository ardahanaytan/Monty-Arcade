---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { languages, useTranslations, type Lang } from '../i18n/ui';

export type NavSection = 'games' | 'devlog' | 'about';

interface Props {
  lang: Lang;
  active?: NavSection;
  /** Her dil için bu sayfanın karşılığı (dil değiştirici). */
  langPaths: Record<Lang, string>;
}

const { lang, active, langPaths } = Astro.props;
const t = useTranslations(lang);

const nav: { id: NavSection; href: string; label: string }[] = [
  { id: 'games', href: `/${lang}/#games`, label: t('nav.games') },
  { id: 'devlog', href: `/${lang}/devlog/`, label: t('nav.devlog') },
  { id: 'about', href: `/${lang}/about/`, label: t('nav.about') },
];
---

<header class="header">
  <div class="container header__inner">
    <Logo lang={lang} />

    <nav class="header__nav" aria-label={t('a11y.mainNav')}>
      {
        nav.map((item) => (
          <a href={item.href} class="navlink" aria-current={active === item.id ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header__tools">
      <div class="lang-switch" role="group" aria-label={t('lang.label')}>
        {
          languages.map((l) => (
            <a
              href={langPaths[l]}
              hreflang={l}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
              data-lang-link={l}
            >
              {l.toUpperCase()}
            </a>
          ))
        }
      </div>
      {
        site.features.accounts && (
          <a href="#" class="login press">
            <Icon name="user" />
            {t('nav.login')}
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  // Son seçilen dili hatırla (kök yönlendirmede öncelik verilir).
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('monty:lang', a.dataset.langLink ?? '');
      } catch {}
    });
  });
</script>

<style>
  .header {
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 28px;
    padding-block: 16px;
  }
  .header__nav {
    display: flex;
    gap: 4px;
  }
  .navlink {
    padding: 10px 16px;
    font-weight: 700;
    font-size: 16px;
    color: var(--text-3);
    text-decoration: none;
    border-radius: 10px;
    text-align: center;
  }
  .navlink:hover {
    color: var(--text);
    background: rgba(243, 234, 216, 0.06);
  }
  .navlink[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .header__tools {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang-switch {
    display: flex;
    padding: 3px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
  }
  .lang-switch a {
    display: grid;
    place-items: center;
    min-width: 40px;
    min-height: 36px;
    padding: 0 10px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 12px;
    color: var(--text-3);
    text-decoration: none;
    border-radius: 7px;
  }
  .lang-switch a:hover {
    color: var(--text);
  }
  .lang-switch a[aria-current='true'] {
    color: var(--on-accent);
    background: var(--text);
  }
  .login {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    font-weight: 800;
    font-size: 15px;
    color: var(--text);
    text-decoration: none;
    border: 1.5px solid var(--line-btn);
    border-radius: 10px;
    background: var(--surface-2);
  }
  .login:hover {
    color: var(--text);
  }

  @media (max-width: 720px) {
    .header__nav {
      order: 3;
      width: 100%;
    }
    .navlink {
      flex: 1;
      padding-inline: 8px;
    }
  }
</style>
