---
/**
 * v2 — Başarım paneli. `features.accounts` kapalıyken çağıran sayfa bunu render etmez.
 * Sunucuda hepsi kilitli çizilir; açılanlar (üye: Supabase, misafir: bu oturum) ve nadirlik
 * yüzdeleri istemci tarafında işaretlenir.
 */
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import type { Game } from '../lib/content';

interface Props {
  lang: Lang;
  game: Game;
}

const { lang, game } = Astro.props;
const t = useTranslations(lang);
const list = game.data.achievements;
const unlocked = 0;
const tierColor = { common: 'var(--text-3)', rare: 'var(--accent)', legendary: 'var(--led)' } as const;
---

<section
  class="ach"
  aria-labelledby="ach-title"
  data-ach-panel={game.id}
  data-lang={lang}
  data-rarity-text={t('ach.rarity')}
>
  <div class="ach__head">
    <h2 id="ach-title" class="subhead">
      <Icon name="trophy" size={20} class="ach__trophy" />
      {t('ach.title')}
    </h2>
    <span class="ach__count"><span data-ach-count>{unlocked}</span> / {list.length}</span>
  </div>
  <div
    class="ach__bar"
    role="progressbar"
    aria-label={t('ach.progress')}
    aria-valuemin="0"
    aria-valuemax={list.length}
    aria-valuenow={unlocked}
    data-ach-bar
  >
    <span style={`width: ${list.length ? (unlocked / list.length) * 100 : 0}%`}></span>
  </div>

  <ul class="ach__list plain">
    {
      list.map((a) =>
        a.hidden ? (
          <li class="ach__item is-locked" data-ach={a.id} style={`--tier: ${tierColor[a.tier]}`}>
            <span class="ach__icon ach__icon--secret">???</span>
            <span class="ach__text">
              <span class="ach__name">{t('ach.hidden')}</span>
              <span class="ach__desc">{t('ach.hiddenText')}</span>
            </span>
            <template data-reveal>
              <span class="ach__icon">
                <Icon name={a.icon} size={22} class="ach__badge" />
              </span>
              <span class="ach__text">
                <span class="ach__name">{a.title[lang]}</span>
                <span class="ach__desc">{a.description[lang]}</span>
                <span class="ach__rarity" data-rarity />
              </span>
              <span class="ach__tier">{t(`ach.${a.tier}`)}</span>
            </template>
          </li>
        ) : (
          <li class="ach__item is-locked" data-ach={a.id} style={`--tier: ${tierColor[a.tier]}`}>
            <span class="ach__icon">
              <Icon name="lock" size={20} class="ach__lock" />
              <Icon name={a.icon} size={22} class="ach__badge" />
            </span>
            <span class="ach__text">
              <span class="ach__name">{a.title[lang]}</span>
              <span class="ach__desc">{a.description[lang]}</span>
              <span class="ach__rarity" data-rarity />
            </span>
            <span class="ach__tier">{t(`ach.${a.tier}`)}</span>
          </li>
        ),
      )
    }
  </ul>

  <div class="ach__foot">
    <a href={`/${lang}/u/`} data-ach-all hidden>{t('ach.all')}</a>
    <button type="button" class="ach__signup" data-login-open data-ach-guest>{t('ach.guestNote')}</button>
  </div>
</section>

<script>
  import { onAccount, profileUrl } from '../lib/client/account';
  import { onAchievementsChange, unlockedIds } from '../lib/client/achievements';
  import { supabase } from '../lib/client/supabase';

  document.querySelectorAll<HTMLElement>('[data-ach-panel]').forEach((panel) => {
    const gameId = panel.dataset.achPanel!;
    const lang = panel.dataset.lang ?? 'en';
    const items = [...panel.querySelectorAll<HTMLElement>('[data-ach]')];
    const count = panel.querySelector<HTMLElement>('[data-ach-count]')!;
    const bar = panel.querySelector<HTMLElement>('[data-ach-bar]')!;
    const all = panel.querySelector<HTMLAnchorElement>('[data-ach-all]')!;
    const guest = panel.querySelector<HTMLElement>('[data-ach-guest]')!;
    const percent = new Intl.NumberFormat(lang, { maximumFractionDigits: 1 });
    const ratios = new Map<string, number>();

    const render = () => {
      const ids = unlockedIds(gameId);
      items.forEach((li) => {
        const open = ids.has(li.dataset.ach!);
        li.classList.toggle('is-locked', !open);
        // Gizli başarım açıldıysa gerçek içeriğini göster.
        const reveal = li.querySelector<HTMLTemplateElement>('template[data-reveal]');
        if (open && reveal) li.replaceChildren(reveal.content.cloneNode(true));
        const ratio = ratios.get(li.dataset.ach!);
        const rarity = li.querySelector<HTMLElement>('[data-rarity]');
        if (rarity && ratio) rarity.textContent = (panel.dataset.rarityText ?? '').replace('{p}', percent.format(ratio * 100));
      });
      count.textContent = String(ids.size);
      bar.setAttribute('aria-valuenow', String(ids.size));
      bar.querySelector('span')!.style.width = `${items.length ? (ids.size / items.length) * 100 : 0}%`;
    };

    onAccount(({ user, profile }) => {
      guest.hidden = Boolean(user);
      all.hidden = !profile?.username;
      if (profile?.username) all.href = profileUrl(lang, profile.username);
    });
    onAchievementsChange(render);
    render();

    // Nadirlik: "Oyuncuların %4'ü açtı" (gerçek veriden).
    supabase
      ?.from('achievement_rarity')
      .select('achievement_id, ratio')
      .eq('game_id', gameId)
      .then(({ data }) => {
        (data ?? []).forEach((r) => ratios.set(r.achievement_id, r.ratio));
        render();
      });
  });
</script>

<style>
  .ach {
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 18px;
    padding: 22px;
  }
  .ach__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 20px;
    line-height: 1.2;
  }
  h2 :global(.ach__trophy) {
    color: var(--led);
  }
  .ach__count {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 14px;
    color: var(--led);
  }
  .ach__bar {
    height: 8px;
    margin-bottom: 18px;
    background: var(--bg);
    border-radius: 999px;
    overflow: hidden;
  }
  .ach__bar span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--led);
  }
  .ach__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }
  .ach__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .ach__icon {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: var(--tier);
    border-radius: 10px;
    background: var(--surface-3);
    border: 1px solid var(--tier);
  }
  .ach__icon :global(.ach__lock) {
    display: none;
  }
  .ach__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }
  .ach__name {
    font-weight: 800;
    font-size: 15px;
  }
  .ach__desc {
    font-size: 13px;
    color: var(--text-3);
  }
  .ach__tier {
    flex: none;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--tier);
  }
  /* Kilitli */
  .is-locked {
    background: transparent;
    border-style: dashed;
    border-color: var(--line-strong);
  }
  .is-locked .ach__icon {
    color: var(--text-5);
    background: var(--surface-2);
    border: 0;
  }
  .is-locked .ach__icon :global(.ach__lock) {
    display: block;
  }
  .is-locked .ach__icon :global(.ach__badge) {
    display: none;
  }
  .is-locked .ach__name {
    color: var(--text-3);
  }
  .is-locked .ach__desc {
    color: var(--text-4);
  }
  .ach__icon--secret {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
  }
  .ach__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .ach__foot a {
    font-weight: 800;
    font-size: 14px;
  }
  .ach__signup {
    padding: 0;
    font: inherit;
    font-weight: 700;
    font-size: 13px;
    color: var(--accent);
    text-align: left;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .ach__signup:hover {
    text-decoration: underline;
  }
  .ach__signup[hidden],
  .ach__foot a[hidden] {
    display: none;
  }
  .ach__rarity {
    font-size: 12px;
    color: var(--text-4);
  }
  .ach__rarity:empty {
    display: none;
  }
</style>
