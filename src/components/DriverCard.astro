---
import Checker from './Checker.astro';
import SocialLinks from './SocialLinks.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="cream-card driver" aria-labelledby="driver-title">
  <Checker variant="cream" bottom />
  <span class="card-eyebrow">{t('driver.eyebrow')}</span>
  <h2 id="driver-title" class="display">{t('driver.title')}</h2>
  <p>{t('driver.text')}</p>
  <div class="driver__foot">
    <a href={`/${lang}/about/`}>{t('driver.link')}</a>
    <SocialLinks lang={lang} variant="cream" />
  </div>
</section>

<style>
  h2 {
    margin-bottom: 8px;
    font-size: 26px;
    line-height: 1.05;
  }
  p {
    margin-bottom: 14px;
    font-size: 15px;
    color: var(--card-ink-2);
  }
  .driver__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
  }
</style>
