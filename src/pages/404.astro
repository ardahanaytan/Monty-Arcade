---
/**
 * Kök 404: hangi dilde istendiği build sırasında bilinmediği için sayfa iki dilde de render edilir
 * (varsayılan EN görünür). Küçük script URL'deki dil önekine, yoksa tarayıcı diline göre doğru kopyayı açar.
 */
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import MontyHelmet from '../components/MontyHelmet.astro';
import { site } from '../config/site';
import { languages, useTranslations } from '../i18n/ui';

const home = { tr: '/tr/', en: '/en/' };
---

<!doctype html>
<html lang="en">
  <head>
    <Head lang="en" title={useTranslations('en')('404.title')} langPaths={home} noindex />
  </head>
  <body>
    {
      languages.map((lang) => {
        const t = useTranslations(lang);
        return (
          <div class="variant" data-variant={lang} data-title={`${t('404.title')} · ${site.name}`} hidden={lang !== 'en'}>
            <a href={`#main-${lang}`} class="skip-link">
              {t('a11y.skip')}
            </a>
            <Header lang={lang} langPaths={home} />
            <main id={`main-${lang}`} tabindex="-1" lang={lang}>
              <div class="container page dnf">
                <MontyHelmet expression="x" size={220} animated={false} />
                <p class="dnf__code mono" aria-hidden="true">
                  {t('404.code')}
                </p>
                <h1 class="display">{t('404.title')}</h1>
                <p class="lead">{t('404.text')}</p>
                <Button href={`/${lang}/`} iconAfter="arrow">
                  {t('404.back')}
                </Button>
              </div>
            </main>
            <Footer lang={lang} />
          </div>
        );
      })
    }

    <script>
      const pathLang = location.pathname.split('/')[1];
      const nav = (navigator.languages?.[0] || navigator.language || '').toLowerCase();
      const lang = pathLang === 'tr' || pathLang === 'en' ? pathLang : nav.startsWith('tr') ? 'tr' : 'en';
      document.querySelectorAll<HTMLElement>('[data-variant]').forEach((el) => {
        const active = el.dataset.variant === lang;
        el.hidden = !active;
        if (active) {
          document.documentElement.lang = lang;
          document.title = el.dataset.title ?? document.title;
        }
      });
    </script>
  </body>
</html>

<style>
  .variant {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .variant[hidden] {
    display: none;
  }
  .dnf {
    align-items: center;
    text-align: center;
    padding-block: 48px 24px;
    gap: 14px;
  }
  .dnf__code {
    font-size: clamp(64px, 12vw, 120px);
    line-height: 1;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-shadow: 0 0 24px var(--accent-glow);
  }
  h1 {
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
  }
  .lead {
    margin-bottom: 12px;
  }
</style>
