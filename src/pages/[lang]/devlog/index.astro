---
import Base from '../../../layouts/Base.astro';
import PostRow from '../../../components/PostRow.astro';
import { getStaticLangPaths, useTranslations, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../lib/content';

export const getStaticPaths = getStaticLangPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
---

<Base lang={lang} title={t('devlog.title')} description={t('devlog.intro')} active="devlog">
  <div class="container page">
    <header class="intro">
      <span class="eyebrow">{t('devlog.pageEyebrow')}</span>
      <h1 class="display">{t('devlog.title')}</h1>
      <p class="lead">{t('devlog.intro')}</p>
    </header>

    {
      posts.length > 0 ? (
        <ol class="posts plain">
          {posts.map((post, i) => (
            <PostRow lang={lang} post={post} index={posts.length - i} />
          ))}
        </ol>
      ) : (
        <p class="empty">{t('devlog.empty')}</p>
      )
    }
  </div>
</Base>

<style>
  .intro h1 {
    margin-bottom: 12px;
    font-size: clamp(40px, 5.6vw, 64px);
    line-height: 1;
  }
  .posts {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .empty {
    color: var(--text-3);
  }
</style>
