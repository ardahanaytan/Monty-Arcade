---
/** Gizlilik politikası ve kullanım koşulları (`src/content/legal/<dil>/*.md`). */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../layouts/Prose.astro';
import { formatDate, useTranslations, type Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const docs = await getCollection('legal');
  return docs.map((doc) => {
    const [lang, legal] = doc.id.split('/');
    return { params: { lang, legal }, props: { doc } };
  });
}

interface Props {
  doc: CollectionEntry<'legal'>;
}

const { doc } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(doc);
---

<Base lang={lang} title={doc.data.title} description={doc.data.description}>
  <div class="container page legal">
    <article class="panel">
      <Prose>
        <h1 class="display">{doc.data.title}</h1>
        <p class="legal__updated">{t('legal.updated')}: {formatDate(doc.data.updated, lang)}</p>
        <Content />
      </Prose>
    </article>
  </div>
</Base>

<style>
  .legal {
    padding-top: 30px;
  }
  h1 {
    font-size: clamp(32px, 6vw, 48px);
    line-height: 1.05;
    color: var(--text);
  }
  .legal__updated {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-4);
  }
</style>
