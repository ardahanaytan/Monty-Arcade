---
import Head, { type HeadProps } from '../components/Head.astro';
import Header, { type NavSection } from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';
import LoginDialog from '../components/LoginDialog.astro';
import AchievementToast from '../components/AchievementToast.astro';
import { site } from '../config/site';
import { resolveLangPaths, useTranslations, type Lang } from '../i18n/ui';

interface Props extends Omit<HeadProps, 'langPaths'> {
  active?: NavSection;
  /** Dil değiştirici ve hreflang için her dildeki karşılık. Verilmezse yolun ilk parçası değiştirilir. */
  langPaths?: Partial<Record<Lang, string>>;
  ticker?: boolean;
}

const { active, langPaths, ticker = true, ...head } = Astro.props;
const { lang } = head;
const t = useTranslations(lang);
const paths = resolveLangPaths(Astro.url.pathname, lang, langPaths);
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head {...head} langPaths={paths} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <Header lang={lang} active={active} langPaths={paths} />
    {ticker && <Ticker lang={lang} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    {
      site.features.accounts && (
        <>
          <LoginDialog lang={lang} />
          <AchievementToast lang={lang} />
        </>
      )
    }
  </body>
</html>
