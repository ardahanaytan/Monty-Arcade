---
/** Devlog yazısı / hakkında metin düzeni: ~68ch genişlik ve markdown stilleri. */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['prose', className]}>
  <slot />
</div>

<style>
  .prose {
    max-width: 68ch;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-2);
    overflow-wrap: break-word;
  }
  .prose :global(> * + *) {
    margin-top: 1.1em;
  }
  .prose :global(h2),
  .prose :global(h3) {
    font-stretch: 112%;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
  }
  .prose :global(h2) {
    margin-top: 1.8em;
    font-size: 26px;
  }
  .prose :global(h3) {
    margin-top: 1.5em;
    font-size: 21px;
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(a) {
    color: var(--led);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    color: var(--led-hover);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li + li) {
    margin-top: 0.4em;
  }
  .prose :global(li::marker) {
    color: var(--accent);
  }
  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 16px 20px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.4em;
    color: var(--text);
    background: var(--bg-deep);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .prose :global(pre) {
    padding: 16px 18px;
    overflow-x: auto;
    background: var(--bg-deep) !important;
    border: 1px solid var(--line);
    border-radius: 12px;
    font-size: 15px;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    padding: 0;
    font-size: inherit;
    background: none;
    border: 0;
  }
  .prose :global(img) {
    border-radius: 12px;
  }
  .prose :global(hr) {
    height: 14px;
    border: 0;
    background: repeating-conic-gradient(var(--text) 0% 25%, var(--bg) 0% 50%) 0 0 / 14px 14px;
    opacity: 0.5;
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 8px 10px;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(th) {
    color: var(--text);
  }
</style>
